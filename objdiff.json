{
  "min_version": "2.0.0",
  "build_target": false,
  "build_base": false,
  "watch_patterns": [
    "src/**/*.cpp",
    "src/**/*.h"
  ],
  "units": [
    {
      "name": "file",
      "target_path": "build/target/file.obj",
      "base_path": "build/obj/src/file.obj"
    },
    {
      "name": "object",
      "target_path": "build/target/object.obj",
      "base_path": "build/obj/src/object.obj"
    },
    {
      "name": "pack",
      "target_path": "build/target/pack.obj",
      "base_path": "build/obj/src/pack.obj"
    },
    {
      "name": "pack_file",
      "target_path": "build/target/pack_file.obj",
      "base_path": "build/obj/src/pack_file.obj"
    },
    {
      "name": "sprite",
      "target_path": "build/target/sprite.obj",
      "base_path": "build/obj/src/sprite.obj"
    },
    {
      "name": "task",
      "target_path": "build/target/task.obj",
      "base_path": "build/obj/src/task.obj"
    },
    {
      "name": "task_list_delete",
      "target_path": "build/target/task_list_delete.obj",
      "base_path": "build/obj/src/task_list_delete.obj"
    }
  ]
}